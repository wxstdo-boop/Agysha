<?xml version="1.0" encoding="utf-8"?>
<!-- Пути, которые FileProvider отдаёт наружу для установки скачанного APK.
     APK качается во временный (cache) каталог приложения, поэтому хватает
     cache-path и external-cache-path. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="apk_cache" path="." />
    <external-cache-path name="apk_external_cache" path="." />
    <!-- APK, скачанный системным DownloadManager, лежит в своей папке
         приложения (Android/data/<pkg>/files/Download/updates). -->
    <external-files-path name="apk_downloads" path="Download/updates/" />
</paths>
