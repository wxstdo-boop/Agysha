<?xml version="1.0" encoding="utf-8"?>
<!-- Фон окна Android до первого кадра Flutter (API 21+).
     `?android:colorBackground` на Realme/MIUI отдаёт серый: между системным
     сплэшем и приложением мелькала серая полоса. Теперь цвет один и тот же
     на всём пути — системный сплэш, окно и первый кадр `_BootBackdrop`. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_background" />
</layer-list>
