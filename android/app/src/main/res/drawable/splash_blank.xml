<?xml version="1.0" encoding="utf-8"?>
<!-- Пустая «иконка» системного сплэша Android 12+ (Realme UI, MIUI и др.).

     Раньше здесь лежал `<shape>` без размеров. Документация Android требует,
     чтобы `windowSplashScreenAnimatedIcon` указывал на VECTOR drawable:
     у shape нет intrinsic-размера, система не может его измерить и
     откатывается на ЛОНЧЕР-ИКОНКУ приложения — отсюда «аватарка с фоном»
     в самом начале запуска, которую рисует прошивка, а не приложение.

     Теперь это валидный vector 108dp с прозрачной заливкой: размер есть,
     рисовать нечего. Логотип показывает сам Flutter-сплэш. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
