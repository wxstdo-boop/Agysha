<?xml version="1.0" encoding="utf-8"?>
<!-- Фон окна Android до первого кадра Flutter.
     Раньше здесь был сплошной белый. Даже с прозрачной иконкой системного
     сплэша это читалось как «вспышка»: системный сплэш рисует персиковый
     фон, потом окно перекрашивается в белый, потом Flutter рисует свой
     первый кадр. Три разных цвета подряд = мигание.
     Теперь везде ОДИН цвет — `brand_background`, как у системного сплэша и
     у `_BootBackdrop` в `main.dart`. Перехода не видно: системного сплэша
     как будто нет. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_background" />
</layer-list>
